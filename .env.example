# Copy to .env.local and set a real staff password before seeding.
# .env.local is ignored by git. Do not commit passwords or API tokens.

DATABASE_URL=postgres://encounter:encounter@localhost:54329/encounter
APP_URL=http://localhost:3210

SEED_ADMIN_EMAIL=admin@encounterworship.local
SEED_ADMIN_NAME=Encounter Administrator
# Quote the password when it contains #, otherwise the rest of the line is ignored.
SEED_ADMIN_PASSWORD="replace-with-a-local-password"
SEED_DEMO_EVENT=true

# WhatsApp Business Platform. Leave unset until the church approves a provider.
# Registrations are saved even when these values are empty.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=
# WHATSAPP_TEMPLATE_LANGUAGE=en
# WHATSAPP_GRAPH_VERSION=v22.0
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
